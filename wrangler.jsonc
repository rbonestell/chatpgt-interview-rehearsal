{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt-interview-rehearsal-mcp",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "build": { "command": "npm run build" },
  "observability": { "enabled": false },
  "routes": [{ "pattern": "chatgpt-interview-rehearsal-mcp.rbonestell.com", "custom_domain": true }],
  "vars": {
    "UI_DOMAIN": "https://chatgpt-interview-rehearsal-mcp.rbonestell.com",
    "ALLOWED_ORIGINS": "https://chatgpt.com,https://chat.openai.com"
  }
}
