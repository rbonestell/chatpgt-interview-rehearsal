{
  "name": "interview-rehearsal-workspace",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "test:worker": "node scripts/worker-test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "bundle": "node scripts/bundle-plugin.mjs",
    "configure:mcp": "node scripts/configure-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
